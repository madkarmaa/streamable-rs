#!/bin/sh
set -eu

bunx lint-staged

if git diff --cached --name-only --diff-filter=ACMR -- \
    '*.rs' 'Cargo.toml' '*/Cargo.toml' 'Cargo.lock' | grep -q .; then
    cargo fmt --all -- --check
    cargo check -p streamable-rs --no-default-features
    cargo test --workspace
    cargo clippy --workspace --all-targets --all-features -- -D warnings
fi

{
    "mcpServers": {
        "chrome-devtools": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest",
                "--no-performance-crux",
                "--no-usage-statistics",
                "--autoConnect",
                "--channel",
                "stable"
            ]
        },
        "codebase-memory": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "codebase-memory-mcp@0.10.8"]
        }
    }
}
